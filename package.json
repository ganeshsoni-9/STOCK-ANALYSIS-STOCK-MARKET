{
  "name": "tradesense-ai",
  "version": "1.0.0",
  "description": "TradeSense AI — Indian Intraday Market Scanner & Market Regime Dashboard",
  "main": "backend/src/server.js",
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "cd backend && npm test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "trading",
    "indian-stock-market",
    "nifty50",
    "technical-analysis",
    "react",
    "nodejs",
    "express",
    "socketio"
  ],
  "author": "TradeSense AI Team",
  "license": "MIT"
}
